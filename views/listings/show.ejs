  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust</title>
  </head> -->

  <% if (listing.geometry?.coordinates?.length) { %>
  <script>
    let mapToken="<%= process.env.MAP_TOKEN %>";
        let coordinates="<%= JSON.stringify(listing.geometry.coordinates) %>";

  </script>
  <% } %>
<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3>Listing details:</h3>
        <br />
      </div>
        <div class="card col-6 offset-3 show-card">
          <div class="card" style="width: 18rem;">
            <img src="<%=listing.image.url || listing.image%>" class="card-img-top show-img" alt="listing image">
          </div>
          <div class="card-body">
           <p class="card-text">
            <p> <b><%= listing.title%></b></p>
             <p> <i>Owned by: <%=listing.owner.username%></i> </p>
             <p> <b> <%= listing.description%></b></p>
    
              <b>&#8377;<%= listing.price.toLocaleString("en-IN")%></b> <br>
             <p> <b><%= listing.location%></b></p> 
             <p><b> <%= listing.country%></b></p> 
            </p>
          </div>
          </div>  
          </div>
        

       
        <br>

        <% if(currentUser && listing.owner._id.equals(currentUser._id)){%>
  <div class="btns">
    <a href="/listings/<%= listing._id %>/edit" class="Addbtn btn offset-3">Edit</a>

    <form action="/listings/<%= listing._id %>?_method=delete" method="post">
      <button class="Addbtn btn offset-5">Delete</button>
    </form>
  </div>
        <hr>
        <% } %>

        <% if(currentUser){%>
          <div class="mb-3 mt-3 needs-validation lsiting-card" novalidate >
            <h4>Leave a review</h4>
            <form action="/listings/<%= listing._id%>/reviews" method="POST" novalidate class="needs-validation">
              <div>
                <label for="rating" class="form-label" >Rating</label>
                <fieldset class="starability-coinFlip">
  <legend>First rating:</legend>
                  <label for="rating" class="form-label" >Rating</label>
  <input type="radio" id="no-rate" name="review[rating]" class="input-no-rate" name="rating" value="0" checked min="1 " aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <!-- <input type="radio" id="first-rate5" name="review[rating]" value="5" /> -->
  <!-- <label for="first-rate5" title="Amazing">5 stars</label> -->
</fieldset>
                <!-- <input type="range" min="1" max="5" name="review[rating]" id="rating" class="form-range" required>
              </div> -->

              <div class="mb-3 mt-3">
                <label for="comment" class="form-label"  >Comment</label>
                
                <textarea name="review[comment]" id="comment" cols="30" rows="5" required></textarea> 
                <div class="invalid-feedback">Please submit comments for review</div>
              </div>

              <button class="btn btn-outline-dark">Submit review</button>
            </form>
        <%}%>
      
         </div>
         
<%if (listing.reviews.length>0){%>
<div class="row">   
         <p><b>All reviews </b></p>

<% for(let review of listing.reviews) { %>
  <div class="card col-5 ms-3 mb-3">
    <div class="card-body">
      <h5 class="card-title"><%=review.author.username%></h5>
      <p class="card-text"><%=review.comment%></p>
      <!-- <p class="card-text">rating:<%=review.rating%>/5</p>  -->
   
  <p class="starability-result" data-rating="<%=review.rating%>">
  </p>
    </div>

    <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=delete" class="mb-3" method="post">
      <button class="btn btn-dark">Delete</button>
    </form>
  </div>
<% } %>
</div>
<%}%>

<% if (listing.geometry?.coordinates?.length) { %>
<div class="col-6 offset-3 mb-3">
  <h3>Where you'll be</h3>
  <div id="map"></div>
</div>
<script src="/css/js/map.js"></script>
<% } else { %>
<div class="col-6 offset-3 mb-3">
  <h3>Where you'll be</h3>
  <p>Map location unavailable.</p>
</div>
<% } %>
</div>
</div>