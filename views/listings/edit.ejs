<div class="row mt-3">
  <div class="col-8 offset-2">
    <h1>Edit your listing</h1>
    <form action="/listings/<%=listing._id%>?_method=put" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          name="listing[title]"
          value="<%=listing.title%>"
          class="form-control"
          required
        /><br />
        <div 
            class="valid-feedback">Looks good</div>
            <div class="invalid-feedback">required field</div>

      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" required>
 <%=listing.description%></textarea
        ><br />
        <div 
        class="valid-feedback">Looks good</div>
      </div>

      <div class="invalid-feedback">Enter a short description</div>

      <div class="mb-3">
        <label for="listingImage" class="form-label">Previous Image </label>
      <br>
        <img src="<%=originalImageURL%>" 
         /> <br>
      

        <label for="listingImage" class="form-label">New Image Link</label>
        <input
          type="file"
          id="listingImage"
          name="listingImage"
          class="form-control"
           accept="image/jpeg,image/png"
           
        /><br />

      </div>

      <div class="row">
        <div class="mb-3 col-mid-4">
           <label for="price" class="form-label" >Price</label>
        <input
          type="number"
          name="listing[price]"
          value="<%=listing.price%>"
          class="form-control"
          required
        /><br />
        <div 
            class="valid-feedback">Looks good</div>
            <div class="invalid-feedback">Enter price</div>
            <div class="invalid-feedback">Enter price</div>

        </div>

        <div class="mb-3 col-mid-8">
          <label for="location" class="form-label">Location</label>
        <input
          type="text"
          name="listing[location]"
          value="<%=listing.location%>"
          class="form-control"
          required
        /><br />
        <div 
            class="valid-feedback">Looks good</div>
            <div class="invalid-feedback">Enter location</div>

        </div>
      </div>
     
      <div class="mb-3">
        <label for="country" class="form-label">Country</label>
        <input
          type="text"
          name="listing[country]"
          value="<%=listing.country%>"
          class="form-control"
          required
        /><br />
        <div 
            class="valid-feedback">Looks good</div>
      </div>
            <div class="invalid-feedback">Enter country name</div>

      <button type="submit" class="Addbtn btn mt-3">Edit</button>
    </form>
      </div>
</div>
        <script  src="/css/js/script.js"></script>

