<h1 class="col-6 offset-3">SignUp on Wanderlust</h1>
<div class="row mt-3">
  <div class="col-6 offset-3">
    <form action="/signup" method="post">
      <div class="mb-3">
        <label for="username" class="form-label" class="needs-validation" novalidate>Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        /><br />
        <div class="valid-feedback">Looks good</div>
        <div class="invalid-feedback">required field</div>
      </div>
       <div class="mb-3">
        <label for="email" class="form-label" class="needs-validation" novalidate>email</label>
        <input
          type="email"
          name="email"
          id="email"
          class="form-control"
          required
        /><br />
        <div class="valid-feedback">Looks good</div>
        <div class="invalid-feedback">required field</div>
      </div>
       <div class="mb-3">
        <label for="password" class="form-label" class="needs-validation" novalidate>password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        /><br />
        <div class="valid-feedback">Looks good</div>
        <div class="invalid-feedback">required field</div>
      </div>
      <button class="btn-success">SignUp</button>
    </form>
  </div>
</div>
