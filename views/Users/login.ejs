<h1 class="col-6 offset-3">Login on Wanderlust</h1>
<div class="row mt-3">
  <div class="col-6 offset-3">
    <form action="/login" method="post">
      <div class="mb-3">
        <label for="username" class="form-label" class="needs-validation" novalidate>Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        /><br />
       
      </div>
       
       <div class="mb-3">
        <label for="password" class="form-label" class="needs-validation" novalidate>password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        /><br />
        
      </div>
      <button type="submit" class="btn-success">Login</button>
    </form>
  </div>
</div>
